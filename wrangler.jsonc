// Cloudflare Workers — the only deploy target for this site. A pure static
// assets Worker: no custom fetch handler. Every request is served straight
// from Cloudflare's asset storage.
//
// "directory" is dist/ — the minified build — and NOT the repo root. This is
// load-bearing, not a preference. It used to be "." with the real deploy path
// passing --assets=dist on the command line instead, which worked only for
// someone running `npm run deploy` by hand. Cloudflare's own builds don't run
// that script: they run the configured build command and then a plain
// `wrangler deploy`, which reads this file, saw ".", and shipped the raw
// unminified source while throwing away the dist/ the build had just made.
// Deployed script.js was 89KB of commented source for months as a result.
// Keeping the path here means every deploy route agrees.
//
// The cost is that dist/ must exist before deploy or preview, which is why
// `npm run dev` builds first. `npm start` (serve.py) is untouched and still
// serves plain source for everyday work.
//
//   npm run deploy     -> npm run build && wrangler deploy
//   npm run dev        -> npm run build && wrangler dev
//   npm start          -> serve.py, plain unminified source
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "snakes-ladders",
  "compatibility_date": "2026-09-13",

  "assets": {
    "directory": "./dist",

    // Cloudflare's default, spelled out because the Indonesian landing page
    // depends on it: dist/id.html is served at /id (and /id.html redirects
    // there), the address its canonical, hreflang and sitemap entries use.
    "html_handling": "auto-trailing-slash",

    // No "binding" here — that's only valid when a Worker script (a "main")
    // actually reads it via env.ASSETS.fetch(). This is a pure assets-only
    // Worker with no script at all, and wrangler dev refuses to start
    // ("Cannot use assets with a binding in an assets-only Worker") if the
    // binding is present without one. Confirmed by actually running it, not
    // just by reading Cloudflare's docs.
  },

  // Declared here rather than left as a dashboard toggle, so every deploy —
  // whoever runs it, from whichever machine — gets the same logging
  // behavior instead of whatever an earlier session happened to click.
  // "persist: false" means these stay real-time (wrangler tail / the Logs
  // tab while live) rather than written to Cloudflare's observability
  // platform for later querying — there's no server-side logic here to
  // generate anything worth long-term retention, just static asset requests.
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": false
    }
  }
}
