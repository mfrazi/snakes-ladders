// Cloudflare Workers (static assets) config — the alternative deploy path,
// for hosting on a Worker instead of Pages (e.g. to later add Worker logic
// alongside the game, like a server-side LLM proxy).
//
// This is a separate file from wrangler.toml on purpose: Pages and
// "Workers with static assets" are deployed with different commands
// (wrangler pages deploy vs wrangler deploy) and Wrangler tells them apart
// by which config shape it's given, so keeping one file per target avoids
// any ambiguity between the two.
//
// Deploy with: npx wrangler deploy --config wrangler.workers.jsonc
// (or `npm run deploy:workers`)
{
  "name": "snake-ladder-love-edition",
  "compatibility_date": "2026-09-13",
  // No "main" field — this is a pure static site, no Worker script needed.
  "assets": {
    "directory": "."
  }
}
