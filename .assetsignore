# Dev-only files — excluded from what actually gets uploaded to Cloudflare.
# Same gitignore-style syntax, honored by both `wrangler pages deploy` and
# `wrangler deploy` (Workers static assets); the deployed site only needs
# index.html, style.css, script.js, data.js, manifest.json, sw.js,
# robots.txt, sitemap.xml, assets/, and icons/.
#
# robots.txt and sitemap.xml must NOT be added here — they only do their job
# if crawlers can fetch them from the deployed origin.
serve.py
wrangler.toml
wrangler.workers.jsonc
package.json
package-lock.json
node_modules
.claude
.wrangler
.git
.gitignore
.assetsignore
*.md
