# Dev-only files — excluded from what actually gets uploaded to Cloudflare.
# Same gitignore-style syntax, honored by `wrangler deploy`; the deployed site
# only needs index.html, style.css, script.js, data.js, manifest.json, sw.js,
# robots.txt, sitemap.xml, assets/, and icons/.
#
# robots.txt and sitemap.xml must NOT be added here — they only do their job
# if crawlers can fetch them from the deployed origin.
wrangler.jsonc
serve.py
package.json
package-lock.json
node_modules
.claude
.github
.wrangler
.git
.gitignore
.assetsignore
LICENSE
*.md
